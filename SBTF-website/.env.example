# Copy to .env and fill in real values. NEVER commit .env.

# Prisma datasource (used by prisma.config.ts for CLI/migrations)
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Runtime connection for Prisma Client (driver adapter)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_YOUR_ANON_KEY"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Email (Nodemailer) - filled in later
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""